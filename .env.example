APP_ENV=production
APP_URL=https://sillage.example.com
APP_KEY=replace-with-64-random-hex-characters
APP_NAME=Sillage
ALLOWED_DOMAIN=cabesto.com
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sillage
DB_USERNAME=sillage
DB_PASSWORD=
# Facultatif : chemin absolu du certificat CA pour une connexion MySQL TLS vérifiée.
DB_SSL_CA=
MAIL_TRANSPORT=mail
MAIL_FROM=sillage@cabesto.com
SESSION_SECURE=true
UPLOAD_MAX_MB=10
# Docker uniquement : secret MySQL root distinct, non transmis au conteneur applicatif.
MYSQL_ROOT_PASSWORD=replace-with-a-distinct-random-password
